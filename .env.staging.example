# ============================================================================
# STAGING environment template — SPARKServ
# ----------------------------------------------------------------------------
# Copy this file to `.env.staging` (git-ignored) and fill in the values from the
# `sparkserv-staging` project: Supabase dashboard → Settings → API.
#
# This FILE holds no secrets — it is a template of placeholders. The real
# `.env.staging` holds the staging keys and is never committed.
#
# The staging scripts in `scripts/` refuse to run unless the target project is
# BOTH different from production AND carrying the marker row described below,
# so a wrong or edited file cannot point them at the live project. See
# `STAGING.md`.
# ============================================================================

# --- sparkserv-staging project ------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_STAGING_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-staging-anon-publishable-key

# Server-only: bypasses RLS. Never prefix it with NEXT_PUBLIC_, and never reuse
# the production key here.
SUPABASE_SERVICE_ROLE_KEY=your-staging-service-role-key

# --- the second lock: the database says which project it is -------------------
# Run this ONCE in the staging SQL Editor, after the schema is applied:
#
#   insert into public.system_settings (key, value)
#   values ('staging_environment', 'sparkserv-staging')
#   on conflict (key) do update set value = excluded.value;
#
# A staging script refuses to run when the URL differs from production but this
# marker is missing or different — the marker is what makes the DATABASE assert
# that it is the disposable one.
SPARKSERV_STAGING_MARKER_KEY=staging_environment
SPARKSERV_STAGING_MARKER_VALUE=sparkserv-staging

# --- optionally needed by the staging app -------------------------------------
# Generate a staging-only pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-staging-vapid-public-key
VAPID_PRIVATE_KEY=your-staging-vapid-private-key

# Staging SMS (a test sender, or left blank to fail soft).
SEMAPHORE_API_KEY=your-staging-semaphore-api-key
SEMAPHORE_SENDER_NAME=YourSenderName

# Protects /api/cron/assignment-tick. Any long random string; staging only.
CRON_SECRET=
